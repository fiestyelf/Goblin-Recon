.venv/
uv.lock
__pycache__/
*.py[cod]
.DS_Store

# Local secrets and machine-specific config
.env
.env.*
!.env.example
secrets.*
*.key
*.pem
*.p12
*.pfx

# Local outputs that may contain sensitive notes or unpublished content
vault/intake/*
vault/briefs/*
vault/reports/*
!vault/intake/.gitkeep
!vault/briefs/.gitkeep
!vault/reports/.gitkeep

# Internal brand and planning docs — not for public repo
docs/
PRE_LAUNCH_CHECKLIST.md

# CI/config files not needed in published repo
/.codacy/

# Runtime logs
*.log
logs/
