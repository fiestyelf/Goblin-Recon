{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "headers": {
        "Authorization": "Bearer {env:EXA_API_KEY}"
      },
      "enabled": true
    },
    "tavily": {
      "type": "local",
      "command": ["npx", "-y", "tavily-mcp@latest"],
      "environment": {
        "TAVILY_API_KEY": "{env:TAVILY_API_KEY}"
      },
      "enabled": true
    },
    "firecrawl": {
      "type": "local",
      "command": ["npx", "-y", "firecrawl-mcp@latest"],
      "environment": {
        "FIRECRAWL_API_KEY": "{env:FIRECRAWL_API_KEY}"
      },
      "enabled": true
    },
    "scrapegraph": {
      "type": "local",
      "command": ["npx", "-y", "scrapegraph-mcp@latest"],
      "environment": {
        "SGAI_API_KEY": "{env:SCRAPEGRAPH_API_KEY}"
      },
      "enabled": true
    }
  }
}