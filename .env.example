# Goblin Recon local environment template.
# Copy to .env only if an integration explicitly requires keys.
# Do not commit .env files.

# === Search & Extraction (recommended for full pipeline quality) ===
# EXA_API_KEY=
# TAVILY_API_KEY=
# FIRECRAWL_API_KEY=
# SCRAPEGRAPH_API_KEY=
# BRAVE_API_KEY=

# === Image Generation (optional; used by carousel renderer) ===
# Get a token from https://replicate.com/account/api-tokens after approval.
# If omitted, carousel generation falls back to CSS gradients.
# REPLICATE_API_TOKEN=

# === Platform APIs (optional; uncomment and fill as needed) ===
# APIFY_TOKEN=
# YOUTUBE_API_KEY=
# X_BEARER_TOKEN=
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=GoblinRecon/0.1 by CompanyName
# META_APP_ID=
# META_APP_SECRET=
# META_ACCESS_TOKEN=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=

# === Output / workflow integrations (optional) ===
# DISCORD_WEBHOOK_URL=
# NOTION_API_KEY=
# NOTION_DATABASE_ID=
# GOOGLE_SHEETS_CREDENTIALS_JSON=
# GOOGLE_SHEETS_SPREADSHEET_ID=
